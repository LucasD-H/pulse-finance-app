DATABASE_URL="postgresql://root:password@localhost:5432/pulsefinance?schema=public"
JWT_SECRET="sua-chave-secreta-aqui"
# Opcional: restringe o CORS à URL do frontend (sem isso, libera qualquer origem)
CORS_ORIGIN="http://localhost:3000"
# Opcional: limite de tentativas de login/cadastro por IP a cada 15 min
# (padrão: 10). Em dev/ao rodar os testes E2E, suba esse valor bastante
# (ex: 1000) para não ser bloqueado pela própria proteção contra força bruta.
AUTH_RATE_LIMIT_MAX=1000
